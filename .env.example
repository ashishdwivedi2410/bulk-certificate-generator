# Copy to .env and adjust. Every variable is optional; the defaults below apply.
# Real environment variables override values in .env.

# Any SQLAlchemy URL. SQLite is the default; for PostgreSQL use e.g.
# postgresql+psycopg://user:password@localhost:5432/certificates (and pip install psycopg[binary])
DATABASE_URL=sqlite:///./certificates.db

# Where generated PDFs / ZIPs are written (default: <project>/generated)
# GENERATED_DIR=generated

# Folder containing certificate_template.json (default: <project>/templates)
# TEMPLATE_DIR=templates

# Maximum recipients accepted in one request (larger requests get a 422)
MAX_RECIPIENTS_PER_JOB=5000
